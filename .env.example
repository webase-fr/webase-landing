# Copiez ce fichier dans .env.local. Ne commitez jamais les secrets.
# URL publique finale (https://...). Vide = site non indexable / prévisualisation.
# Domaine confirmé : https://webase.fr
SITE_URL=

# Envoi direct via Resend : aucun mot de passe Gmail.
# Créez une clé limitée à l’envoi pour un domaine vérifié.
RESEND_API_KEY=
# Expéditeur prévu : Webase <projets@mail.webase.fr>
# À activer après vérification du sous-domaine mail.webase.fr dans Resend.
MAIL_FROM=
MAIL_TO=luis.doudeau@gmail.com

# Protection des formulaires partagée entre les instances de production.
# Base Redis Upstash, de préférence en région UE.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Facultatif : seulement si l’hébergeur écrase ce header.
# Vercel : x-vercel-forwarded-for ; Cloudflare : cf-connecting-ip.
# Ne pas utiliser x-forwarded-for sans connaître la chaîne de proxy.
TRUSTED_IP_HEADER=

# Coordonnées légales du fournisseur d’hébergement définitif.
HOSTING_NAME=
HOSTING_ADDRESS=
HOSTING_CONTACT=
